class car:
    def __init__(self, brand, model, price):
        self.brand = brand
        self.model = model
        self.price = price
    def display(self):
        print("Brand: Mahindra")
        print("model: suzuki")
        print("price: 2000000")
    def check_price(self):
        if self.price > 1000000:
            print("expensive card")
        else:
            print("affordable car")
c1 = car("mahindra", "suzuki", 2000000)
c1.display()
c1.check_price()

