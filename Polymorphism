class Book:
    def __init__(self, title, author, price):
        self.title = title
        self.author = author
        self.price = price
    def __str__(self):
        return f"title: {self.title}, author: { self.author}, price: {self.price}"
    
    
b1 = Book("Maths", "Aryabatta", 200)
print(b1)
