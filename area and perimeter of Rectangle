class Rectangle():
    def __init__(self, length, width):
        self.length = length
        self.width = width
    def area(self):
        print("Area:", self.length * self.width)
    def perimeter(self):
        print("Perimeter:", 2 * (self.length + self.width))
        
r1 = Rectangle(15, 20)
r1.area()
r1.perimeter()
