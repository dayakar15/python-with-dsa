class Employee:
    def __init__(self, name, salary):
        self.name = name
        self.salary = salary
    def display(self):
        print("Employee name:", self.name)
        print("Salary:", self.salary)
    def calculate_bonus(self):
        if self.salary >= 50000:
            bonus = self.salary * 10 / 100
        elif self.salary >= 30000:
            bonus = self.salary * 7 / 100
        else:
            bonus = self.salary * 5 / 100
        print("Bonus:", bonus)
        
            
e1 = Employee("chintu", 70000)
e1.calculate_bonus()
e1.display()
