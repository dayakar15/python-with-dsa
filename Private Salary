class Employees:
    def __init__(self, name, salary):
        self.name = name
        self._salary = salary
    def show_salary(self, amount):
        print("Salary:", self._salary)
    def increase_salary(self, amount):
        self._salary = self._salary + amount
        print("increase salary amount", amount)
e1 = Employees("chintu", 30000)
e1.show_salary(10000)
e1.increase_salary(5000)
    
